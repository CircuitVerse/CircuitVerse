<div>
  <h2>Welcome to CircuitVerse, <%= @user.name %></h2>
  <%= inline_svg_tag "svgs/newAssignment.svg", alt: "New Assignment", class: "mailer-assignment-image" %>
  <p class="mailer-text">
    The assignment <span class="mailer-highlighted-text"><%= @assignment.name %> (<%= @assignment.deadline %>)</span> has been updated. <br>
    Assignment is mentored by <span class="mailer-highlighted-text">@assignment.group.primary_mentor.name</span>
  </p>
  <% group = @assignment.group %>
  <% assignment_url = group&.organization && Flipper.enabled?(:organizations, @user) ? organization_group_assignment_url(group.organization, group, @assignment) : group_assignment_url(group, @assignment) %>
  <a href="<%= assignment_url %>" class="mailer-button">View Assignment</a>
  <p class="mailer-text">Keep building!</p>
</div>
