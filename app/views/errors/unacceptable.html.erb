<link rel="stylesheet" type="text/css" href="/css/error.css">

<div class="container text-center">
  <div class="row row-errorpage">
    <div class="col col-sm col-md col-lg">
      <div class="error-code bold pt-5">422</div>
    </div>
  </div>
  <div class="row row-errorpage">
    <div class="col col-sm col-md col-lg">
      <div class="help-text-main mb-4"><%= t("errors.unacceptable.title") %></div>
    </div>
  </div>
  <div class="row row-errorpage">
    <div class="col col-sm col-md col-lg">
      <a href="<%= root_path(locale: I18n.locale) %>" class="return text-decoration-none pb-5"><i class="fa fa-chevron-left pe-2"></i><%= t("errors.return_to_homepage") %></a>
    </div>
  </div>
</div>
