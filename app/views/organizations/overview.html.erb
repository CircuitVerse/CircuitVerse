<% content_for :title, t("organizations.dashboard.page_title", organization: @organization.name, tab: t("organizations.tabs.overview")) %>
<%= render(OrganizationDashboardShellComponent.new(organization: @organization, active_tab: "overview", user_organizations: @user_organizations, user_organizations_has_more: @user_organizations_has_more, show_settings_tab: policy(@organization).admin_access?)) do |shell| %>
  <% shell.with_tab_content do %>
    <header class="d-flex flex-column flex-sm-row gap-4 align-items-start mb-4">
      <div class="org-dash-logo d-flex align-items-center justify-content-center flex-shrink-0 overflow-hidden rounded-4 border bg-light">
        <% if @organization.logo.attached? %>
          <%= image_tag @organization.logo, alt: t(".logo_alt", organization: @organization.name), class: "w-100 h-100 object-fit-cover" %>
        <% else %>
          <span class="org-dash-logo-fallback fw-bold"><%= @organization.name.first.upcase %></span>
        <% end %>
      </div>
      <div class="org-dash-info pt-1">
        <p class="org-dash-info-name fw-bold mb-2"><%= @organization.name %></p>
        <% if @organization.description.present? %>
          <p class="org-dash-info-desc lh-base mb-3 text-secondary"><%= @organization.description %></p>
        <% end %>
        <div class="d-flex align-items-center gap-3 flex-wrap">
          <% has_links = @organization.links.present? && @organization.links.reject(&:blank?).any? %>
          <% if has_links %>
            <%= render(OrganizationSocialLinksComponent.new(links: @organization.links)) %>
          <% end %>
          <% if @organization.location.present? %>
            <% if has_links %><span class="org-dash-meta-sep" aria-hidden="true"></span><% end %>
            <span class="org-dash-location d-inline-flex align-items-center gap-2 text-secondary">
              <i class="fa fa-map-marker-alt lh-1" aria-hidden="true"></i>
              <%= @organization.location %>
            </span>
          <% end %>
        </div>
      </div>
    </header>
    <section>
      <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="org-dash-section-title fw-semibold m-0 fs-5"><%= t(".groups_heading") %></h3>
        <% if policy(@organization).create_group? %>
          <%= link_to new_organization_group_path(@organization), class: "btn primary-button d-inline-flex align-items-center gap-1" do %>
            <i class="fa fa-plus" aria-hidden="true"></i> <%= t(".new_group_button") %>
          <% end %>
        <% end %>
      </div>
      <% if @groups.blank? %>
        <div class="org-dash-empty text-center rounded-4 py-5 px-3 text-secondary">
          <i class="fa fa-layer-group d-block mb-2 opacity-50" aria-hidden="true"></i>
          <p class="m-0 fw-medium"><%= t(".no_groups") %></p>
        </div>
      <% else %>
        <div class="row center-row">
          <% @groups.each do |group| %>
            <% can_manage = OrganizationGroupPolicy.new(current_user, group).manage? %>
            <div class="col-12 col-sm-12 col-md-6 col-lg-4">
              <div class="groups-card groups-mentor-card">
                <div class="groups-mentor-card-name"><%= group.name %></div>
                <div>
                  <p><%= t("users.circuitverse.groups.total_members", group_member_count: group.group_members_count) %></p>
                </div>
                <div class="groups-mentor-card-mini-buttons">
                  <%= link_to organization_group_path(@organization, group), class: "mini-button groups-mentor-card-view-mini-button" do %>
                    <%= image_tag("svgs/viewGroup.svg", alt: "View Group") %>
                    <span><%= t("view") %></span>
                  <% end %>
                  <% if can_manage %>
                    <%= link_to edit_organization_group_path(@organization, group), class: "mini-button groups-mentor-card-edit-mini-button" do %>
                      <%= image_tag("svgs/editGroup.svg", alt: "Edit Group") %>
                      <span><%= t("edit") %></span>
                    <% end %>
                    <%= link_to "#", class: "mini-button groups-mentor-card-delete-mini-button", data: { bs_toggle: "modal", bs_target: "#deletegroupModal", delete_path: organization_group_path(@organization, group) } do %>
                      <%= image_tag("svgs/deleteGroup.svg", alt: "Delete Group") %>
                      <span><%= t("delete") %></span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
        <%= render partial: "users/circuitverse/delete_group_confirmation_modal" %>
        <script type="text/javascript">
          $(document).ready(function() {
            $("#deletegroupModal").on("show.bs.modal", function(e) {
              let deletePath = $(e.relatedTarget).data('delete-path');
              $(e.currentTarget).find('#groups-group-delete-button').attr("href", deletePath);
            });
          });
        </script>
        <div class="org-index-pagination mt-4">
          <%= will_paginate @groups, param_name: "groups_page", renderer: PaginateRenderer %>
        </div>
      <% end %>
    </section>
  <% end %>
<% end %>
