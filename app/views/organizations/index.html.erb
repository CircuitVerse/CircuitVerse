<% content_for :title, t("organizations.index.page_title") %>
<div class="container org-index">
  <div class="column org-index-header">
    <h2 class="org-index-header-title"><%= t("organizations.index.heading") %></h2>
    <p class="org-index-header-description"><%= t("organizations.index.subtitle") %></p>
    <div class="org-index-header-action">
      <%= link_to new_organization_path, class: "btn primary-button d-inline-flex align-items-center gap-1" do %>
        <i class="fa fa-plus" aria-hidden="true"></i> <%= t("organizations.index.create_button") %>
      <% end %>
    </div>
  </div>
  <div class="org-index-page-line"></div>
  <% if @organizations.blank? %>
    <%= render "shared/no_results", message: t("organizations.index.empty_mine") %>
  <% else %>
    <div class="org-index-list-wrapper">
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% @organizations.each do |organization| %>
          <div class="col">
            <%= link_to overview_organization_path(organization),
                        class: "text-decoration-none org-index-card-link" do %>
              <div class="org-index-card h-100">
                <div class="org-index-card-banner">
                  <%= image_tag "organization_banner.png", alt: "", class: "org-index-card-banner-img" %>
                  <div class="org-index-card-logo">
                    <% if organization.logo.attached? %>
                      <%= image_tag organization.logo, alt: t("organizations.index.logo_alt", organization: organization.name), class: "org-index-card-logo-img" %>
                    <% else %>
                      <span class="org-index-card-logo-fallback"><%= organization.name.first.upcase %></span>
                    <% end %>
                  </div>
                </div>
                <div class="org-index-card-details">
                  <div class="org-index-card-name">
                    <span class="org-index-card-name-link"><%= organization.name %></span>
                  </div>
                  <div class="org-index-card-meta">
                    <span class="org-index-card-meta-text">
                      <i class="fa fa-user" aria-hidden="true"></i><%= t("organizations.index.member_count", count: organization.members_count) %>
                    </span>
                  </div>
                  <% if organization.location.present? %>
                    <div class="org-index-card-meta">
                      <span class="org-index-card-meta-text">
                        <i class="fa fa-map-marker-alt" aria-hidden="true"></i><%= organization.location %>
                      </span>
                    </div>
                  <% end %>
                  <% if organization.description.present? %>
                    <div class="org-index-card-description">
                      <span><%= truncate(organization.description, length: 100) %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
    <div class="container pagination-cont">
      <%= will_paginate @organizations, renderer: PaginateRenderer %>
    </div>
  <% end %>
</div>