<% content_for :title, "CircuitVerse - #{@project.name}" %>
<div class="container py-4">
  <h2><%= @project.name %></h2>
  <p class="text-muted"><%= @project.template_visibility.humanize %> template by <%= link_to @author.name, user_path(@author) %></p>
  <% if @project.circuit_preview.attached? %>
    <%= image_tag @project.circuit_preview, class: "img-fluid mb-3", alt: @project.name %>
  <% end %>
  <p><%= @project.description %></p>
  <%= link_to t("launch_simulator"), simulator_user_project_path(@author, @project), class: "btn primary-button" %>
</div>
