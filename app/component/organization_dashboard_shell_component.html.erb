<div class="org-dash mx-auto text-body pt-4 px-3 pb-5">
  <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <h1 class="org-dash-name fw-semibold m-0 fs-5"><%= @organization.name %></h1>
    <div class="dropdown org-switcher">
      <button class="btn btn-sm btn-light dropdown-toggle org-switcher-btn d-inline-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa fa-exchange-alt" aria-hidden="true"></i> <%= t("organizations.switcher.button") %>
      </button>
      <div class="dropdown-menu org-switcher-menu p-2 rounded-4 shadow">
        <div class="dropdown-header"><%= t("organizations.switcher.heading") %></div>
        <% @user_organizations.each do |item| %>
          <% org = item[:organization] %>
          <%= link_to overview_organization_path(org),
                      class: "dropdown-item org-switcher-item d-flex align-items-center gap-2 rounded-3 #{'is-current' if current_org?(org)}" do %>
            <span class="org-switcher-badge d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-3 overflow-hidden fw-semibold text-white">
              <% if org.logo.attached? %>
                <%= image_tag org.logo, alt: "", class: "w-100 h-100 object-fit-cover" %>
              <% else %>
                <%= initials(org) %>
              <% end %>
            </span>
            <span class="org-switcher-info d-flex flex-column flex-fill min-w-0">
              <span class="org-switcher-name fw-semibold"><%= org.name %></span>
              <span class="org-switcher-meta"><%= item[:role].capitalize %> · <%= t("organizations.switcher.group_count", count: item[:group_count]) %> · <%= t("organizations.switcher.member_count", count: item[:member_count]) %></span>
            </span>
            <% if current_org?(org) %>
              <i class="fa fa-check org-switcher-check ms-auto" aria-hidden="true"></i>
            <% end %>
          <% end %>
        <% end %>
        <div class="dropdown-divider"></div>
        <%= link_to new_organization_path, class: "dropdown-item org-switcher-create d-flex align-items-center gap-2 rounded-3 fw-semibold" do %>
          <i class="fa fa-plus" aria-hidden="true"></i> <%= t("organizations.switcher.create") %>
        <% end %>
      </div>
    </div>
  </div>
  <nav aria-label="<%= t('organizations.tabs.nav_label') %>">
    <ul class="nav nav-pills gap-2 flex-wrap mb-3">
      <li class="nav-item">
        <%= link_to t("organizations.tabs.overview"), overview_organization_path(@organization), class: tab_class("overview") %>
      </li>
      <li class="nav-item">
        <%= link_to t("organizations.tabs.members"), members_organization_path(@organization), class: tab_class("members") %>
      </li>
      <% if show_settings_tab? %>
        <li class="nav-item">
          <%= link_to t("organizations.tabs.settings"), settings_organization_path(@organization), class: tab_class("settings") %>
        </li>
      <% end %>
    </ul>
  </nav>
  <hr class="mt-3 mb-4">
  <%= tab_content %>
</div>
