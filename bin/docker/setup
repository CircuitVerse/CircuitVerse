#!/bin/sh
set -e

# Remove tmp folder (sudo: a prior run may have left files owned by a
# different container uid, e.g. after switching hosts)
sudo rm -rf /circuitverse/tmp
# Rails writes to log/ from the first command below; reclaim it for the
# same reason, without touching the tracked log/.keep file
sudo chown -R "$(id -un):$(id -gn)" /circuitverse/log


# Install ruby dependencies
gem install bundler
gem install mailcatcher
bundle config set --local without "production"
bundle config set --local path "/home/vendor/bundle"
bundle install
# Install node dependencies
yarn
# Setup database
bundle exec rails db:create
bundle exec rails db:schema:load
bundle exec rails db:migrate
bundle exec rails db:seed
# generate key-pair for jwt-auth
# if private.pem and public.pem does not exists
if [ ! -f "/circuitverse/config/private.pem" ] && [ ! -f "/circuitverse/config/public.pem" ]; then
  openssl genrsa -out /circuitverse/config/private.pem 2048
  openssl rsa -in /circuitverse/config/private.pem -outform PEM -pubout -out /circuitverse/config/public.pem
fi
# Check if `cv-frontend-vue` folder exists
if [ ! -f "/circuitverse/cv-frontend-vue/package.json" ]; then
  echo "cv-frontend-vue folder not found"
  echo "Use git submodule update --init to clone cv-frontend-vue"
  exit 1
fi

# Reclaim node_modules if a prior run under a different container uid left
# root-owned files here, e.g. after upgrading this dev container
if [ -d /circuitverse/cv-frontend-vue/node_modules ]; then
  sudo chown -R "$(id -un):$(id -gn)" /circuitverse/cv-frontend-vue/node_modules
fi

# Run `npm install` in `cv-frontend-vue` folder
cd /circuitverse/cv-frontend-vue && npm install && cd /circuitverse

# Write a tmp file to indicate that setup is complete
mkdir -p /circuitverse/tmp
touch /circuitverse/tmp/setup_complete